{
  "name": "migii-toeic-tiktok-live",
  "version": "0.1.0",
  "private": true,
  "description": "Game livestream TikTok đố từ vựng TOEIC cho app Migii TOEIC (fork từ tiktok-live-quiz của Jaemy)",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node server.js --sim",
    "demo": "node server.js --sim",
    "demo:bot": "node server.js --autostart --tag demo-bot",
    "demo:duoi450": "node server.js --sim --program-order word,emoji,irrfill,scramble,startend,flag,irrfind,bricky,haitu,listenmean,oneletter,hunt,chain --word-file data/word-300.json,data/word-400.json --seg-total word=20,emoji=20,flag=20,irrfill=16,scramble=20,irrfind=16,bricky=8,haitu=6,listenmean=16,oneletter=20",
    "demo:450-650": "node server.js --sim --program-order word,scramble,fillin,listenmean,errhunt,crossword --seg-total word=20,fillin=10 --level mid --word-file data/word-500.json,data/word-600.json --err-file data/san-loi-600.json --cross-file data/o-chu-600.json",
    "demo:650-800": "node server.js --sim --program-order word,speedread,dictate --word-file data/word-700.json --read-file data/doc-nhanh-700.json --dict-file data/nghe-chep-700.json",
    "demo:tren800": "node server.js --sim --program-order word,speedread --word-file data/word-800.json,data/word-900.json --read-file data/doc-nhanh-800.json",
    "build:word300": "node build_word.js 300",
    "build:word400": "node build_word.js 400",
    "build:word500": "node build_word.js 500",
    "build:word600": "node build_word.js 600",
    "build:word700": "node build_word.js 700",
    "build:word800": "node build_word.js 800",
    "build:word900": "node build_word.js 900",
    "build:ochu600": "node build_o_chu.js",
    "build:audio700": "node build_audio.js --sentences data/nghe-chep-700.json",
    "demo:all": "node gateway.js --port 8789",
    "design:figma": "node design/src/xuat_man_that.js",
    "live": "./go_live.sh studio",
    "control": "open http://localhost:8788/control",
    "build:bank": "node build_bank.js",
    "build:bricky": "node build_bricky.js",
    "build:anh-hai-tu": "node build_hai_tu_anh.js",
    "build:motchu": "node build_mot_chu.js",
    "build:audio": "node build_audio.js",
    "build:qr": "node build_qr.js",
    "demo:gia-su": "node gia-su/server.js",
    "build:gia-su": "node gia-su/build_bai.js",
    "live:gia-su": "./gia-su/live.sh",
    "live:gia-su:sim": "./gia-su/live.sh --sim",
    "binh-luan:gia-su": "node gia-su/xem-binh-luan.js",
    "control:gia-su": "node gia-su/control.js",
    "video:gia-su": "node gia-su/xuat-video.js",
    "xem-video:gia-su": "node gia-su/xuat-video.js --xem"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "dictionary-en": "^4.0.0",
    "nspell": "^2.1.5",
    "tiktok-live-connector": "^2.5.0",
    "ws": "^8.22.1"
  },
  "devDependencies": {
    "qrcode": "^1.5.4"
  }
}
