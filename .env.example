# Điền rồi chạy ./go_live.sh — KHÔNG commit file .env
# ---- Bắt buộc khi lên live ----
TIKTOK_USER=
# ---- Chỉ khi phát thẳng bằng OBS (LIVE Producer có stream key) ----
TIKTOK_RTMP_URL=
TIKTOK_STREAM_KEY=
# ---- Link tải app cho mã QR trên màn live (nên là link thông minh có tham số chiến dịch) → npm run build:qr ----
APP_LINK=
# ---- Tuỳ chọn ----
# Giờ phiên sau, hiện trên màn cảm ơn cuối buổi
NEXT_LIVE=
# Mã mở màn điều khiển từ điện thoại (?key=…). Để trống = tự sinh mỗi lần chạy
CONTROL_KEY=
# Cổng server (mặc định 8788)
PORT=
# MC AI "Ninja Migii" trả lời bình luận (gateway Claude nội bộ). Trống = AI tắt, game vẫn chạy
CLAUDE_API_TOKEN=
AI_GATEWAY_URL=
# Giọng đọc tiếng Việt VieNeu chạy local (đường dẫn python của venv đã cài vieneu). Trống = giọng trình duyệt
VIENEU_PY=
# Khoá Euler Stream (dịch vụ ký request cho thư viện đọc chat TikTok) — gói free bị giới hạn số lần nối/giờ
EULER_API_KEY=
